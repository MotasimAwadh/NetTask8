@using NetTask8.Utility
@model Request

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Request <span class="text-muted">#</span>@Model.FileNumber</h5>
                <a class="btn btn-sm btn-outline-secondary"
                   asp-action="Download"
                   asp-route-id="@Model.Id">
                    <i class="bi bi-download"></i> Download
                </a>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted fw-normal">File Number</dt>
                    <dd class="col-sm-9">@Model.FileNumber</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Subject</dt>
                    <dd class="col-sm-9">@Model.Subject</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Date</dt>
                    <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Status</dt>
                    <dd class="col-sm-9 mb-0">@Model.Status</dd>
                </dl>
            </div>

            <div class="card-footer bg-light py-3">
                <form asp-action="ChangeStatus" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="col-sm">
                        <select asp-for="Status" class="form-select" required>
                            <option value="">-- Select action --</option>
                            <option value="@StaticDetails.Approved">@StaticDetails.Approved</option>
                            <option value="@StaticDetails.Rejected">@StaticDetails.Rejected</option>
                        </select>
                    </div>

                    <div class="col-sm-auto d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                </form>
            </div>
        </div>
    </div>
</div>